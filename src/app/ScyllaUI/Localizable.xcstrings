            "state": "translated",
            "value": "Font size:"
          }
        }
      }
    },
    "完成": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "完成一轮时发通知（您没在看那个终端时）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify when a turn finishes (in a terminal you are not viewing)"
          }
        }
      }
    },
    "对话所在的目录已不存在：%@\n%@ 按启动目录保存会话，换到别的目录无法恢复。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The conversation's directory no longer exists: %1$@\n%2$@ saves sessions per launch directory, so it can't be resumed from another directory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "对话所在的目录已不存在：%1$@\n%2$@ 按启动目录保存会话，换到别的目录无法恢复。"
          }
        }
      }
    },
    "将从 ScyllaUI 的库里立即删除这些任务的标题、提示词、回复摘要与事件记录，删除后无法在 ScyllaUI 中恢复。正在运行的任务与 Agent 自己的会话记录不受影响。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This immediately deletes their titles, prompts, reply summaries and event history from ScyllaUI's database. They can't be restored in ScyllaUI. Running tasks and the agent's own session history are not affected."
          }
        }
      }
    },
    "将立即从 ScyllaUI 的库里删除 %lld 条已结束的对话": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ended task will be deleted from ScyllaUI's database now"
                }
              },
