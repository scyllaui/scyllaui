            "state": "translated",
            "value": "About"
          }
        }
      }
    },
    "关掉的段不再显示。CPU 与内存都关掉时不再统计，分支与改动关掉时不再读取改动数。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turned-off items are hidden. With both CPU and memory off, usage is no longer sampled; with branch and changes off, change counts are no longer read."
          }
        }
      }
    },
    "关闭": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
