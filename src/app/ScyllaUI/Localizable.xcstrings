        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This immediately deletes the task's title, prompts, reply summary and event history from ScyllaUI. It can't be restored in ScyllaUI. The agent's own session history is not affected; you can still resume it in the agent with its session ID."
          }
