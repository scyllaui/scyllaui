    "写入 %@（%lld 条）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write %1$@ (%#@entries@)"
          },
          "substitutions": {
            "entries": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg entry"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg entries"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "写入 %1$@（%2$lld 条）"
          }
        }
      }
    },
