    "NSAppleEventsUsageDescription": {
      "comment": "系统授权框里的用途说明（M4b 块 1）",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running in ScyllaUI would like to use AppleScript to control other apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ScyllaUI 终端里运行的程序想使用 AppleScript 控制其他 App。"
