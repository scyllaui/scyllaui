# Toolchains, dependencies and vendored sources
.tools/
vendor/
.build/
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# Build and generated output
build/
dist/
target/
output/
DerivedData/
# Generated by XcodeGen from project.yml
*.xcodeproj/

# Xcode per-user state
xcuserdata/
*.xcuserstate

# Credentials and environment files
.env*
*.pem
*.key
secrets/

# System, editor and private AI configuration
.DS_Store
.AppleDouble
.LSOverride
.idea/
.vscode/
.claude/
.codex/
.agents/
# Hook config goldens simulate a user's CLI config dirs and must be tracked (hookcfg_compat)
!tests/hook-config/**/.claude/
!tests/hook-config/**/.codex/

# Temporary files
tmp-*
*.tmp
*.log
*.swp
*~
